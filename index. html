<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>D. Vivek - Cyber Security Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #111111;
            --bg-charcoal: #151515;
            --bg-card: #202020;
            --primary-red: #C62828;
            --crimson: #8E1B1B;
            --bright-accent: #E53935;
            --text-primary: #F2F2F2;
            --text-muted: #A8A8A8;
            --border-color: #3A3A3A;
            --glow-color: #E53935;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'JetBrains Mono', monospace;
            background-color: var(--bg-dark);
            color: var(--text-primary);
            overflow-x: hidden;
            position: relative;
        }

        /* Background Elements */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                radial-gradient(circle at 20% 80%, rgba(198, 40, 40, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(198, 40, 40, 0.1) 0%, transparent 50%);
            z-index: -1;
            pointer-events: none;
        }

        .dotted-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: radial-gradient(circle, rgba(58, 58, 58, 0.3) 1px, transparent 1px);
            background-size: 20px 20px;
            z-index: -1;
            opacity: 0.5;
        }

        .floating-binary {
            position: fixed;
            color: var(--text-muted);
            font-size: 12px;
            opacity: 0.1;
            pointer-events: none;
            animation: float 20s infinite linear;
            z-index: -1;
        }

        @keyframes float {
            from { transform: translateY(100vh) rotate(0deg); }
            to { transform: translateY(-100px) rotate(360deg); }
        }

        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            background-color: rgba(17, 17, 17, 0.95);
            backdrop-filter: blur(10px);
            z-index: 1000;
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-brand {
            font-family: 'Fredoka', cursive;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-red);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-primary);
            text-decoration: none;
            font-weight: 500;
            position: relative;
            transition: color 0.3s;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background-color: var(--primary-red);
            transition: width 0.3s;
        }

        .nav-links a:hover {
            color: var(--primary-red);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .system-status {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background-color: var(--bright-accent);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--glow-color);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }

        .hamburger {
            display: none;
            flex-direction: column;
            cursor: pointer;
            gap: 4px;
        }

        .hamburger span {
            width: 25px;
            height: 3px;
            background-color: var(--text-primary);
            transition: 0.3s;
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 6rem 2rem 2rem;
            position: relative;
        }

        .hero-content {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            gap: 4rem;
        }

        .hero-text {
            flex: 1;
        }

        .hero-name {
            font-family: 'Fredoka', cursive;
            font-size: clamp(3rem, 8vw, 6rem);
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            position: relative;
            display: inline-block;
        }

        .hero-name::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 100%;
            height: 4px;
            background-color: var(--primary-red);
            transform: skewX(-20deg);
        }

        .hero-subtitle {
            font-size: 1.5rem;
            color: var(--primary-red);
            margin-bottom: 1.5rem;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .hero-description {
            font-size: 1.1rem;
            color: var(--text-muted);
            margin-bottom: 2rem;
            max-width: 600px;
            line-height: 1.6;
        }

        .terminal {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .terminal::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, var(--primary-red), transparent);
            animation: scan 3s linear infinite;
        }

        @keyframes scan {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .terminal-line {
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

        .terminal-prompt {
            color: var(--primary-red);
        }

        .hero-buttons {
            display: flex;
            gap: 1.5rem;
        }

        .btn {
            padding: 0.8rem 2rem;
            background-color: transparent;
            border: 2px solid var(--primary-red);
            color: var(--primary-red);
            font-family: 'Fredoka', cursive;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background-color: var(--primary-red);
            transition: left 0.3s;
            z-index: -1;
        }

        .btn:hover {
            color: var(--bg-dark);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(198, 40, 40, 0.3);
        }

        .btn:hover::before {
            left: 0;
        }

        .hero-illustration {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .cyber-illustration {
            width: 100%;
            max-width: 500px;
            height: auto;
        }

        /* About Section */
        .about {
            padding: 4rem 2rem;
            position: relative;
        }

        .section-heading {
            font-family: 'Fredoka', cursive;
            font-size: 2.5rem;
            color: var(--primary-red);
            margin-bottom: 3rem;
            text-align: center;
            position: relative;
            display: inline-block;
            width: 100%;
        }

        .section-heading::before,
        .section-heading::after {
            content: '///';
            position: absolute;
            color: var(--text-muted);
            font-size: 1.2rem;
        }

        .section-heading::before {
            left: -2rem;
        }

        .section-heading::after {
            right: -2rem;
        }

        .about-content {
            max-width: 800px;
            margin: 0 auto;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 2.5rem;
            position: relative;
            overflow: hidden;
        }

        .about-content::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background-image: 
                radial-gradient(circle, rgba(198, 40, 40, 0.1) 1px, transparent 1px);
            background-size: 20px 20px;
            transform: rotate(45deg);
            z-index: 0;
        }

        .about-text {
            position: relative;
            z-index: 1;
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .education-summary {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
            position: relative;
            z-index: 1;
        }

        .edu-item {
            background-color: rgba(31, 31, 31, 0.8);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 1rem;
            flex: 1;
            min-width: 200px;
            position: relative;
            overflow: hidden;
        }

        .edu-item::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: var(--primary-red);
        }

        .edu-year {
            color: var(--primary-red);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .edu-degree {
            font-weight: 500;
        }

        /* Education Timeline */
        .timeline-section {
            padding: 4rem 2rem;
            position: relative;
        }

        .timeline-container {
            max-width: 1000px;
            margin: 0 auto;
            position: relative;
            padding: 2rem 0;
        }

        .timeline-path {
            position: absolute;
            top: 0;
            left: 50%;
            width: 2px;
            height: 100%;
            background-image: repeating-linear-gradient(
                to bottom,
                var(--primary-red) 0,
                var(--primary-red) 5px,
                transparent 5px,
                transparent 10px
            );
            transform: translateX(-50%);
            z-index: 0;
        }

        .timeline-item {
            display: flex;
            margin-bottom: 4rem;
            position: relative;
            z-index: 1;
        }

        .timeline-item:nth-child(odd) {
            justify-content: flex-start;
        }

        .timeline-item:nth-child(even) {
            justify-content: flex-end;
        }

        .timeline-content {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 1.5rem;
            width: 45%;
            position: relative;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        .timeline-item:nth-child(odd) .timeline-content {
            margin-right: auto;
        }

        .timeline-item:nth-child(even) .timeline-content {
            margin-left: auto;
        }

        .timeline-node {
            position: absolute;
            width: 16px;
            height: 16px;
            background-color: var(--primary-red);
            border-radius: 50%;
            top: 0;
            transform: translateX(-50%);
            box-shadow: 0 0 10px var(--glow-color);
            z-index: 2;
        }

        .timeline-item:nth-child(odd) .timeline-node {
            left: calc(50% - 22.5%);
        }

        .timeline-item:nth-child(even) .timeline-node {
            left: calc(50% + 22.5%);
        }

        .timeline-year {
            font-family: 'Fredoka', cursive;
            font-size: 1.2rem;
            color: var(--primary-red);
            margin-bottom: 0.5rem;
        }

        .timeline-title {
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .timeline-description {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Projects Section */
        .projects {
            padding: 4rem 2rem;
            position: relative;
        }

        .projects-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
        }

        .project-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 2rem;
            position: relative;
            overflow: hidden;
            transition: all 0.3s;
        }

        .project-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, var(--primary-red), transparent);
        }

        .project-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-red);
            box-shadow: 0 10px 20px rgba(198, 40, 40, 0.2);
        }

        .project-number {
            position: absolute;
            top: 1rem;
            right: 1rem;
            font-family: 'Fredoka', cursive;
            font-size: 2rem;
            color: var(--text-muted);
            opacity: 0.5;
        }

        .project-icon {
            width: 60px;
            height: 60px;
            margin-bottom: 1rem;
        }

        .project-title {
            font-family: 'Fredoka', cursive;
            font-size: 1.5rem;
            color: var(--primary-red);
            margin-bottom: 1rem;
        }

        .project-description {
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            line-height: 1.5;
        }

        .project-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .tag {
            background-color: rgba(198, 40, 40, 0.2);
            color: var(--primary-red);
            padding: 0.3rem 0.8rem;
            border-radius: 4px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .project-status {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .status-light {
            width: 8px;
            height: 8px;
            background-color: var(--bright-accent);
            border-radius: 50%;
            box-shadow: 0 0 5px var(--glow-color);
        }

        /* Interests Section */
        .interests {
            padding: 4rem 2rem;
            position: relative;
        }

        .interests-grid {
            max-width: 1000px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 2rem;
        }

        .interest-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 2rem;
            display: flex;
            align-items: center;
            gap: 2rem;
            transition: all 0.3s;
        }

        .interest-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-red);
            box-shadow: 0 10px 20px rgba(198, 40, 40, 0.2);
        }

        .interest-icon {
            width: 80px;
            height: 80px;
            flex-shrink: 0;
        }

        .interest-text {
            font-family: 'Fredoka', cursive;
            font-size: 1.8rem;
            color: var(--primary-red);
        }

        /* Security Section */
        .security-section {
            padding: 4rem 2rem;
            position: relative;
        }

        .terminal-interface {
            max-width: 900px;
            margin: 0 auto;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 2.5rem;
            position: relative;
        }

        .terminal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        .terminal-title {
            font-family: 'Fredoka', cursive;
            font-size: 1.5rem;
            color: var(--primary-red);
        }

        .terminal-cmd {
            margin-bottom: 1.5rem;
        }

        .cmd-line {
            margin-bottom: 1rem;
            font-size: 1.1rem;
        }

        .cmd-prompt {
            color: var(--primary-red);
        }

        .security-shield {
            display: flex;
            justify-content: center;
            margin: 2rem 0;
            position: relative;
        }

        .floating-icons {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
        }

        .floating-icon {
            position: absolute;
            opacity: 0.7;
            animation: float-icon 10s infinite ease-in-out;
        }

        @keyframes float-icon {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(10deg); }
        }

        /* Contact Section */
        .contact {
            padding: 4rem 2rem;
            position: relative;
        }

        .contact-panel {
            max-width: 800px;
            margin: 0 auto;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 2.5rem;
        }

        .contact-info {
            text-align: center;
            margin-bottom: 2rem;
        }

        .contact-name {
            font-family: 'Fredoka', cursive;
            font-size: 2rem;
            color: var(--primary-red);
            margin-bottom: 0.5rem;
        }

        .contact-title {
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        .contact-university {
            color: var(--text-muted);
            margin-bottom: 2rem;
        }

        .contact-links {
            display: flex;
            justify-content: center;
            gap: 2rem;
        }

        .contact-link {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            color: var(--text-primary);
            transition: all 0.3s;
        }

        .contact-link:hover {
            color: var(--primary-red);
        }

        .contact-icon {
            width: 50px;
            height: 50px;
            background-color: rgba(198, 40, 40, 0.1);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: all 0.3s;
        }

        .contact-link:hover .contact-icon {
            background-color: var(--primary-red);
        }

        /* Footer */
        footer {
            padding: 2rem;
            text-align: center;
            border-top: 1px solid var(--border-color);
        }

        .footer-text {
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        .system-footer {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            color: var(--text-muted);
        }

        /* Responsive Design */
        @media (max-width: 992px) {
            .hero-content {
                flex-direction: column;
                text-align: center;
            }
            
            .hero-illustration {
                margin-top: 3rem;
            }
        }

        @media (max-width: 768px) {
            .hamburger {
                display: flex;
            }
            
            .nav-links {
                position: fixed;
                top: 70px;
                left: -100%;
                width: 100%;
                height: calc(100vh - 70px);
                background-color: var(--bg-charcoal);
                flex-direction: column;
                justify-content: flex-start;
                padding: 2rem;
                transition: left 0.3s;
            }
            
            .nav-links.active {
                left: 0;
            }
            
            .timeline-item {
                justify-content: flex-start !important;
            }
            
            .timeline-item:nth-child(even) .timeline-content {
                margin-left: 0 !important;
            }
            
            .timeline-node {
                left: 0 !important;
            }
            
            .timeline-path {
                left: 20px !important;
            }
            
            .interests-grid {
                grid-template-columns: 1fr;
            }
            
            .contact-links {
                flex-direction: column;
                gap: 1rem;
            }
        }

        /* Animations */
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.6s, transform 0.6s;
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Glitch Effect */
        .glitch {
            position: relative;
            color: var(--primary-red);
            font-family: 'Fredoka', cursive;
            font-weight: 700;
        }

        .glitch::before,
        .glitch::after {
            content: attr(data-text);
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        .glitch::before {
            animation: glitch-1 0.5s infinite;
            color: var(--bright-accent);
            z-index: -1;
        }

        .glitch::after {
            animation: glitch-2 0.5s infinite;
            color: var(--crimson);
            z-index: -2;
        }

        @keyframes glitch-1 {
            0%, 100% { clip-path: inset(0 0 0 0); transform: translate(0); }
            20% { clip-path: inset(20% 0 30% 0); transform: translate(-2px, 2px); }
            40% { clip-path: inset(50% 0 20% 0); transform: translate(2px, -2px); }
            60% { clip-path: inset(10% 0 60% 0); transform: translate(-2px, 1px); }
            80% { clip-path: inset(80% 0 5% 0); transform: translate(1px, -1px); }
        }

        @keyframes glitch-2 {
            0%, 100% { clip-path: inset(0 0 0 0); transform: translate(0); }
            20% { clip-path: inset(60% 0 10% 0); transform: translate(2px, -2px); }
            40% { clip-path: inset(20% 0 50% 0); transform: translate(-2px, 2px); }
            60% { clip-path: inset(30% 0 40% 0); transform: translate(1px, -1px); }
            80% { clip-path: inset(5% 0 80% 0); transform: translate(-1px, 1px); }
        }

        /* Particle Animation */
        .particle {
            position: fixed;
            pointer-events: none;
            opacity: 0.5;
            z-index: -1;
        }

        @keyframes moveParticle {
            0% {
                transform: translate(0, 0);
            }
            100% {
                transform: translate(var(--x-end), var(--y-end));
            }
        }
    </style>
</head>
<body>
    <!-- Background Elements -->
    <div class="dotted-bg"></div>
    <div id="binary-container"></div>

    <!-- Navigation -->
    <nav>
        <div class="nav-brand">D. VIVEK</div>
        <div class="nav-links" id="navLinks">
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#education">Education</a>
            <a href="#projects">Projects</a>
            <a href="#interests">Interests</a>
            <a href="#contact">Contact</a>
        </div>
        <div class="system-status">
            <span class="status-dot"></span>
            <span>SYSTEM ONLINE</span>
        </div>
        <div class="hamburger" id="hamburger">
            <span></span>
